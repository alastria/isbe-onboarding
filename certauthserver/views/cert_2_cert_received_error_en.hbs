{{define "cert_received_error_en"}}
{{template "preamble" .}}
{{template "logobar" .}}

<div class="ui hidden divider"></div>

<div class="ui container">

    <div class="ui raised segment" style="border-radius:1rem">

        <div class="ui five ordered stackable steps">
            <div class="completed step">
                <div class="content">
                    <div class="title">Certificate</div>
                    <div class="description">Select certificate</div>
                </div>
            </div>
            <div class="active step">
                <div class="content">
                    <div class="title">Email</div>
                    <div class="description">Provide email</div>
                </div>
            </div>
            <div class="disabled step">
                <div class="content">
                    <div class="title">Verify Email</div>
                    <div class="description">Enter code</div>
                </div>
            </div>
            <div class="disabled step">
                <div class="content">
                    <div class="title">Contract</div>
                    <div class="description">Fill out data</div>
                </div>
            </div>
            <div class="disabled step">
                <div class="content">
                    <div class="title">Completed</div>
                    <div class="description">Review and accept contract</div>
                </div>
            </div>
        </div>

    </div>


    <div class="ui raised segment" style="border-radius:1rem">

        <h2 class="ui huge header">Certificate received</h2>

        {{ if .isPersonal }}
        <div class="ui red icon message">
            <i class="exclamation triangle icon"></i>
            <div class="content">
                <div class="header">Note</div>
                We do not accept personal certificates. Please use a certificate of a legal representative of an
                organization.
            </div>
        </div>
        {{ end }}

        {{ if .serviceError }}
        <div class="ui red icon message">
            <i class="exclamation triangle icon"></i>
            <div class="content">
                <div class="header">Note</div>
                We had temporary problems validating the certificate. Please try again a bit later.
            </div>
        </div>
        {{ else if .validationError }}
        <div class="ui yellow icon message">
            <i class="exclamation triangle icon"></i>
            <div class="content">
                <div class="header">Note</div>
                This certificate is not valid according to eIDAS standards, and we cannot accept it.
            </div>
        </div>
        {{ end }}

        <div class="ui divider"></div>

        <div class="ui teal segment">

            {{ if .subject.OrganizationIdentifier }}
            <h3 class="ui header"><i class="building icon"></i>Organizational certificate data</h3>
            {{ else }}
            <h3 class="ui header"><i class="user icon"></i>Personal certificate data</h3>
            {{ end }}

            <div class="ui list">

                {{ if .subject.OrganizationIdentifier }}
                <div class="item"><strong>Organization Identifier:</strong>
                    {{ .subject.OrganizationIdentifier }}
                </div>
                {{ end }}

                {{ if .subject.Organization }}
                <div class="item"><strong>Organization:</strong> {{ .subject.Organization }}</div>
                {{ end }}

                {{ if .subject.OrganizationalUnit }}
                <div class="item"><strong>Organizational Unit:</strong> {{ .subject.OrganizationalUnit }}</div>
                {{ end }}

                {{ if .subject.Country }}
                <div class="item"><strong>Country:</strong> {{ .subject.Country }}</div>
                {{ end }}

                {{ if .subject.CommonName }}
                <div class="item"><strong>Common Name:</strong> {{ .subject.CommonName }}</div>
                {{ end }}

                {{ if .subject.SerialNumber }}
                <div class="item"><strong>Serial Number:</strong> {{ .subject.SerialNumber }}</div>
                {{ end }}

                {{ if .subject.EmailAddress }}
                <div class="item"><strong>Email:</strong> {{ .subject.EmailAddress }}</div>
                {{ end }}

                {{ if .subject.Locality }}
                <div class="item"><strong>Locality:</strong> {{ .subject.Locality }}</div>
                {{ end }}

                {{ if .subject.Province }}
                <div class="item"><strong>Province:</strong> {{ .subject.Province }}</div>
                {{ end }}

                {{ if .subject.StreetAddress }}
                <div class="item"><strong>Street:</strong> {{ .subject.StreetAddress }}</div>
                {{ end }}

                {{ if .subject.PostalCode }}
                <div class="item"><strong>Postal Code:</strong> {{ .subject.PostalCode }}</div>
                {{ end }}

            </div>
        </div>

    </div>

</div>

{{template "postamble" .}}
{{end}}
