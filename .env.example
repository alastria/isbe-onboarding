# CertAuth Docker Compose Environment Variables Example
# Copy this file to .env and customize as needed

# Development mode (set to false for production)
CERTAUTH_DEVELOPMENT=true

# Admin password for accessing admin interfaces
CERTAUTH_ADMIN_PASSWORD=admin123

# Service URLs (change for production domains)
CERTAUTH_URL=https://certauth.localhost
CERTSEC_URL=https://certsec.localhost
ONBOARD_URL=https://onboard.localhost

# Service ports
CERTAUTH_PORT=8010
CERTSEC_PORT=8011
ONBOARD_PORT=8012

# TSA (Timestamp Authority)
# These are dummy values for local development: timestamping fails with them.
# NEVER put real credentials in this file or in the repository. In Coolify use
# secret environment variables, or mount a file and use TSA_PASSWORD_FILE.
TSA_USER=dev_user
TSA_PASSWORD=dev_password
# Required for isbe-dev, isbe-pre and isbe-pro (HTTPS only). The local profile
# defaults to the provider's pre-production endpoint.
# TSA_URL=https://<tsa-endpoint>
# Optional (see tsaservice/README.md):
# TSA_USER_FILE=/run/secrets/tsa_user
# TSA_PASSWORD_FILE=/run/secrets/tsa_password
# TSA_TRUST_ANCHORS_FILE=/certs/tsa-anchors.pem
# TSA_TRUST_ANCHOR_SHA256=011e258310b37f92030d14a672079507632cf72789fc101ce0a0bdc5ef2808cc
# TSA_INTERMEDIATES_FILE=/certs/tsa-intermediates.pem
# TSA_HASH_ALGORITHM=sha512
# TSA_POLICY_OID=0.4.0.2023.1.1
# TSA_NONCE=true
# TSA_TIMEOUT=30s
# TSA_REVOCATION_CHECK=none

# SMTP credentials for email functionality
# These are dummy values for local development
# Replace with real SMTP credentials for production
SMTP_USERNAME=dev@localhost
SMTP_PASSWORD=dev_password
